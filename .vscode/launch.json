{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train 4DRadar local file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/train.py",
            "cwd": "${workspaceFolder}/tools",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--cfg_file",
                "cfgs/radar_models/exp27_radial_rcs_consistency_gate.yaml",
                "--extra_tag",
                "file_base",
                "--batch_size",
                "1",
                "--workers",
                "0",
                "--set",
                "DATA_CONFIG.STORAGE.TYPE",
                "file",
                "DATA_CONFIG.STORAGE.INFO_TYPE",
                "file",
                "DATA_CONFIG.DATA_PATH",
                "/workspace/data/1000_original_data/",
                "DATA_CONFIG.PKL_PATH",
                "/workspace/data/1000_original_data/",
                "DATA_CONFIG.INFO_PATH.train",
                "['infos_test_1000.pkl']",
                "DATA_CONFIG.INFO_PATH.test",
                "['infos_test_1000.pkl']"
            ]
        }
    ]
}
